# ── Server Configuration ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Connection ────────────────────────────────────────────────────────
# Replace with your MongoDB connection string (Atlas or Local)
# Atlas Example: mongodb+srv://<username>:<password>@cluster0.skzylfq.mongodb.net/monitorx?retryWrites=true&w=majority
# Local Example: mongodb://127.0.0.1:27017/server-monitoring
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.skzylfq.mongodb.net/monitorx?retryWrites=true&w=majority

# ── Frontend URL (Used for CORS) ──────────────────────────────────────────────
CLIENT_URL=http://localhost:3002

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_EXPIRES_IN=7d

# ── SMTP Email Alert Settings (Optional for Real Email Notifications) ──────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
EMAIL_FROM="ServerPulse Alerts" <your_email@gmail.com>
EMAIL_TO=recipient_alert_email@gmail.com

# ── Agent API Settings ────────────────────────────────────────────────────────
# Fallback global API key for legacy agents
AGENT_API_KEY=default-secure-key-123

# Public Backend URL when deployed (e.g. Render / Railway / AWS)
# DASHBOARD_URL=https://your-backend.onrender.com
